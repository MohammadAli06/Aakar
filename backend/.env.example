# CraftConnect — Environment Configuration
# Copy this to .env and fill in your values

# ─── App ────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ─── PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://craftconnect:craftconnect@localhost:5432/craftconnect

# ─── Firebase ────────────────────────────────────────────────
# Path to your serviceAccountKey.json downloaded from Firebase Console.
# Required: the backend verifies the app's Firebase ID tokens on every request.
# Project must match the app's android/app/google-services.json (`aakar-sih`).
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=aakar-sih
FIREBASE_STORAGE_BUCKET=aakar-sih.firebasestorage.app

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── AI / LLM ────────────────────────────────────────────────
# Groq (free, fast) → get at https://console.groq.com
LLM_API_KEY=your_groq_api_key_here
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-70b-versatile

# Product Studio: OpenAI API billing is separate from ChatGPT subscriptions.
# Never put this key in Flutter. Existing GEMINI_* entries are no longer used.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=180

# ─── Bhashini ASR ────────────────────────────────────────────
# Register at https://bhashini.gov.in/ulca/model-api-key
BHASHINI_API_KEY=your_bhashini_api_key_here

# ─── Sarvam AI (alternative ASR/TTS) ─────────────────────────
# Register at https://dashboard.sarvam.ai → get API key
# Use as alternative to Bhashini for speech-to-text and text-to-speech
SARVAM_API_KEY=your_sarvam_api_key_here

# ─── JWT ─────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production

# Shared hackathon workspace (disabled by default; use run_demo.ps1 for local setup)
ENABLE_DEMO_WORKSPACE=false
WORKSPACE_DEMO_TOKEN=
ADMIN_ACCESS_TOKEN=
