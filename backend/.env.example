# CraftConnect — Environment Configuration
# Copy this to .env and fill in your values

# ─── App ────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ─── PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://craftconnect:craftconnect@localhost:5432/craftconnect

# ─── Firebase ────────────────────────────────────────────────
# Path to your serviceAccountKey.json downloaded from Firebase Console.
# Required: the backend verifies the app's Firebase ID tokens on every request.
# Project must match the app's android/app/google-services.json (`aakar-sih`).
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=aakar-sih
FIREBASE_STORAGE_BUCKET=aakar-sih.firebasestorage.app

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── AI / LLM ────────────────────────────────────────────────
# Groq (free, fast) → get at https://console.groq.com
# llama-3.1-70b-versatile was retired by Groq; openai/gpt-oss-120b is the current
# large text model on the free tier. Other live slugs: openai/gpt-oss-20b,
# qwen/qwen3.8-27b, groq/compound, groq/compound-mini.
# Photo catalog suggestions use the selectable profile below.
LLM_API_KEY=your_groq_api_key_here
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Per-task overrides (optional). Anything left unset inherits LLM_* above, so an
# existing .env keeps working untouched. The free tier serves extraction, generation,
# negotiation; their existing OpenAI fallback behavior is unchanged.
# EXTRACTION_MODEL=openai/gpt-oss-120b
# GENERATION_MODEL=openai/gpt-oss-120b
# NEGOTIATION_MODEL=openai/gpt-oss-120b
# Each task also accepts its own _BASE and _KEY when it should hit a different provider:
# EXTRACTION_BASE= / EXTRACTION_KEY= / GENERATION_BASE= / GENERATION_KEY=
# NEGOTIATION_BASE= / NEGOTIATION_KEY=

# Change ONE switch, then restart the backend. Groq tasks above are unaffected.
# openai: OpenAI image editing + catalog/pricing vision + translation judge.
# cloudinary_openrouter: Cloudinary removal + Gemma for the other three tasks.
# cloudinary_gemini: Cloudinary removal + direct Google Gemini for the other three.
# No automatic OpenAI fallback in the cloudinary_openrouter profile.
AI_PROVIDER_PROFILE=openai
CLOUDINARY_URL=
# Example: cloudinary://<api_key>:<api_secret>@u59wk44t
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free
AI_TIMEOUT_SECONDS=180
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Product Studio: OpenAI API billing is separate from ChatGPT subscriptions.
# Never put this key in Flutter. Existing GEMINI_* entries are no longer used.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_VISION_MODEL=gpt-4.1-mini
# Translation judge model when AI_PROVIDER_PROFILE=openai.
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=180

# ─── Bhashini ASR ────────────────────────────────────────────
# Register at https://bhashini.gov.in/ulca/model-api-key
BHASHINI_API_KEY=your_bhashini_api_key_here

# ─── Sarvam AI (alternative ASR/TTS) ─────────────────────────
# Register at https://dashboard.sarvam.ai → get API key
# Use as alternative to Bhashini for speech-to-text and text-to-speech
SARVAM_API_KEY=your_sarvam_api_key_here

# ─── JWT ─────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production

# Shared hackathon workspace (disabled by default; use run_demo.ps1 for local setup)
ENABLE_DEMO_WORKSPACE=false
WORKSPACE_DEMO_TOKEN=
ADMIN_ACCESS_TOKEN=
