# Aakar admin console — optional local configuration.
# Copy to .env.local and adjust. Both values default to a local backend.

# Where Vite proxies /api during development. Point this at a dev tunnel or a
# remote host when the backend is not on localhost.
BACKEND_URL=http://localhost:8000

# Absolute API prefix the browser calls. Leave unset to use the /api/v1 default
# through the proxy above. Set it for a built deployment on another origin, e.g.
# VITE_API_BASE_URL=https://api.example.com/api/v1
# VITE_API_BASE_URL=
